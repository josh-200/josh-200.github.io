#portfolioDemoBadge{position:fixed;right:12px;bottom:12px;z-index:999999;background:#111827;color:#fff;border:1px solid #ffffff2b;border-radius:999px;padding:9px 12px;font:700 11px system-ui;box-shadow:0 8px 30px #0005}#portfolioDemoBadge button{margin-left:8px;border:0;border-radius:999px;padding:5px 8px;cursor:pointer}

:root{
  --primary:#146c4b;--primary-2:#0d5439;--primary-soft:#c0f1d8;--on-primary:#fff;
  --secondary:#8a5d00;--secondary-soft:#ffe2a7;--tertiary:#216a78;
  --bg:#f6f8f4;--surface:#fbfdf9;--surface-2:#eef2ed;--text:#181d1a;--muted:#5f6963;
  --line:#d5dcd6;--danger:#ba1a1a;--danger-soft:#ffdad6;--shadow:0 12px 35px rgba(22,50,37,.08);
  font-family:Inter,Segoe UI,Roboto,Arial,sans-serif;color:var(--text);background:var(--bg)
}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}
button{cursor:pointer}.hidden{display:none!important}.muted{color:var(--muted)}.small{font-size:13px}.ok{color:#08733f}.err{color:var(--danger);white-space:pre-wrap}
.login{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 15% 15%,#c0f1d8 0,transparent 35%),radial-gradient(circle at 90% 90%,#ffe2a7 0,transparent 28%),var(--bg)}
.login-card{width:min(460px,100%);background:var(--surface);border:1px solid var(--line);border-radius:28px;padding:30px;box-shadow:var(--shadow)}
.logo{width:60px;height:60px;border-radius:20px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary);font-size:29px;margin-bottom:16px}
h1,h2,h3{margin:0}.login-card h1{font-size:30px}.login-card p{margin:8px 0 20px}.field{display:grid;gap:6px;margin:10px 0}.field label{font-size:13px;font-weight:700;color:var(--muted)}
input,select,textarea{width:100%;border:1px solid var(--line);background:#fff;border-radius:13px;padding:11px 12px;outline:none;color:var(--text)}
input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(20,108,75,.12)}
.btn{border:0;border-radius:13px;padding:11px 15px;font-weight:700;transition:.16s}.btn:hover{transform:translateY(-1px)}
.primary{background:var(--primary);color:#fff}.secondary{background:var(--primary-soft);color:var(--primary-2)}.amber{background:var(--secondary-soft);color:#5d3e00}.ghost{background:transparent;color:var(--primary)}.danger{background:var(--danger-soft);color:var(--danger)}
.app{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:100vh}.side{position:sticky;top:0;height:100vh;padding:20px 14px;background:#0f3f2d;color:#fff;display:flex;flex-direction:column}
.brand{display:flex;align-items:center;gap:11px;padding:8px 10px 22px}.brand-icon{width:42px;height:42px;background:#c0f1d8;color:#0f583c;border-radius:14px;display:grid;place-items:center;font-size:22px}.brand strong{font-size:19px;display:block}.brand span{color:#bde1cd;font-size:12px}
.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;color:#d4e5dc;text-align:left;padding:11px 12px;border-radius:12px;font-weight:650}.nav button:hover,.nav button.active{background:#ffffff1b;color:#fff}.nav button.active{box-shadow:inset 3px 0 #ffd27a}
.side-bottom{margin-top:auto}.side-bottom button{width:100%}.main{min-width:0;padding:0 26px 36px}.topbar{position:sticky;top:0;z-index:10;background:rgba(246,248,244,.9);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:space-between;padding:18px 0 14px;border-bottom:1px solid rgba(213,220,214,.75);margin-bottom:22px}
.topbar h2{font-size:24px}.topbar-right{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.sync-status{font-size:12px;color:var(--muted)}
section{display:none}section.active{display:block}.hero{background:linear-gradient(135deg,#0f6546,#167453);color:#fff;border-radius:24px;padding:24px;display:flex;justify-content:space-between;align-items:center;gap:20px;box-shadow:var(--shadow);margin-bottom:18px}.hero h1{font-size:30px}.hero p{margin:7px 0 0;color:#d8f3e6}.hero-badge{background:#ffffff1f;border:1px solid #ffffff2b;border-radius:18px;padding:15px 18px;text-align:center;min-width:160px}.hero-badge b{font-size:26px;display:block}
.grid{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:14px}.metric,.card{background:var(--surface);border:1px solid var(--line);border-radius:20px;box-shadow:0 5px 22px rgba(22,50,37,.05)}.metric{padding:17px}.metric .label{font-size:13px;color:var(--muted);font-weight:700}.metric b{display:block;font-size:25px;margin:7px 0 4px}.metric small{color:var(--muted)}
.card{padding:18px}.card h3{font-size:18px;margin-bottom:12px}.two{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:16px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.toolbar{display:flex;align-items:end;gap:8px;flex-wrap:wrap}.toolbar .field{margin:0;min-width:150px}.toolbar-grow{flex:1;min-width:220px}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:14px}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:11px 12px;border-bottom:1px solid #edf0ed;text-align:left;vertical-align:top}th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);background:#f7faf7;position:sticky;top:0}tr:last-child td{border-bottom:0}.pill{display:inline-block;border-radius:99px;padding:4px 9px;background:var(--surface-2);font-size:12px;font-weight:700}.pill.green{background:#d6f5e4;color:#0b6641}.pill.amber{background:#fff0c9;color:#795100}.pill.red{background:#ffdedb;color:#a41313}
.product-row{display:grid;grid-template-columns:minmax(180px,1fr) 170px 110px auto;gap:8px;align-items:center;padding:10px 0;border-bottom:1px solid #edf0ed}.product-row:last-child{border-bottom:0}.product-title{font-weight:750}.cartline{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #edf0ed}.cartline:last-child{border-bottom:0}.cartline .right{display:flex;align-items:center;gap:8px}.total{font-size:28px;font-weight:850;margin:14px 0}.subtle{background:var(--surface-2);border-radius:14px;padding:11px 12px;color:var(--muted);font-size:13px}.notice{background:#fff4d8;border:1px solid #f2d186;border-radius:14px;padding:11px 12px;color:#624700}.actions{display:flex;gap:6px;flex-wrap:wrap}.icon-btn{border:0;background:var(--surface-2);width:34px;height:34px;border-radius:10px}.range{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}.range button{border:1px solid var(--line);background:#fff;border-radius:12px;padding:8px 13px}.range button.active{background:var(--primary-soft);border-color:#9cdbbb;color:var(--primary-2);font-weight:800}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:100;display:grid;place-items:center;padding:20px}.modal{width:min(650px,100%);max-height:90vh;overflow:auto;background:var(--surface);border-radius:22px;padding:20px;box-shadow:0 20px 70px rgba(0,0,0,.25)}.modal h3{margin-bottom:12px}.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.section-title h3{font-size:21px}.empty{padding:20px;color:var(--muted);text-align:center}
@media(max-width:1100px){.grid{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}.three{grid-template-columns:1fr 1fr}}
@media(max-width:820px){.app{grid-template-columns:1fr}.side{position:static;height:auto}.brand{padding-bottom:10px}.nav{display:flex;overflow:auto;padding-bottom:4px}.nav button{white-space:nowrap}.side-bottom{display:none}.main{padding:0 14px 28px}.topbar{top:0}.hero{align-items:flex-start;flex-direction:column}.hero-badge{width:100%}.grid,.three{grid-template-columns:1fr 1fr}.product-row{grid-template-columns:1fr 130px}.product-row input,.product-row select{grid-row:2}.modal-grid{grid-template-columns:1fr}}
@media(max-width:520px){.grid,.three{grid-template-col