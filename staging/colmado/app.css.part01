umns:1fr}.topbar{align-items:flex-start;gap:10px;flex-direction:column}.product-row{grid-template-columns:1fr}.product-row input,.product-row select{grid-row:auto}}

/* v0.6 adaptive POS */
.settings-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:16px;align-items:start}.settings-menu{position:sticky;top:88px;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:10px;box-shadow:0 5px 22px rgba(22,50,37,.05)}.settings-menu button{width:100%;border:0;background:transparent;text-align:left;padding:11px 12px;border-radius:12px;color:var(--text);font-weight:700}.settings-menu button:hover,.settings-menu button.active{background:var(--primary-soft);color:var(--primary-2)}.settings-menu button.danger-tab{color:var(--danger)}.settings-pane{display:none}.settings-pane.active{display:block}.settings-stack{display:grid;gap:14px}.settings-row{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line)}.settings-row:last-child{border-bottom:0}.settings-row input[type=checkbox]{width:auto;transform:scale(1.15)}.danger-card{border-color:#efb8b2;background:#fff8f7}.danger-card h3{color:var(--danger)}.danger-card .btn{margin-right:8px;margin-top:6px}.segmented{display:flex;gap:6px;flex-wrap:wrap}.segmented button{border:1px solid var(--line);background:var(--surface);padding:8px 12px;border-radius:999px}.segmented button.active{background:var(--primary-soft);color:var(--primary-2);border-color:#9cdbbb;font-weight:800}.sale-viewbar{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}.sale-product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}.sale-card{border:1px solid var(--line);border-radius:16px;background:#fff;padding:12px;display:grid;gap:8px;min-height:165px}.sale-card .product-title{font-size:15px}.sale-card .sale-card-actions{display:grid;grid-template-columns:1fr 78px;gap:7px}.sale-card .btn{grid-column:1/-1}.pc-dark{--bg:#101411;--surface:#171c18;--surface-2:#222923;--text:#e2e9e3;--muted:#aeb8b1;--line:#39443c;--primary-soft:#154e38;--primary-2:#bde7d1;--secondary-soft:#5f430a;--danger-soft:#5b211f}.pc-dark input,.pc-dark select,.pc-dark textarea,.pc-dark table,.pc-dark .range button,.pc-dark .sale-card{background:#171c18;color:var(--text)}.pc-dark th{background:#202721}.pc-dark .topbar{background:rgba(16,20,17,.9)}.pc-compact .card{padding:13px}.pc-compact th,.pc-compact td{padding:8px 9px}.pc-compact .product-row{padding:7px 0}.pc-compact .metric{padding:13px}.setting-note{font-size:12px;color:var(--muted);margin-top:4px}.backup-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0}.backup-summary div{background:var(--surface-2);border-radius:12px;padding:10px;text-align:center}.backup-summary b{display:block;font-size:18px}
@media(max-width:980px){.settings-shell{grid-template-columns:1fr}.settings-menu{position:static;display:flex;overflow:auto;gap:5px}.settings-menu button{width:auto;white-space:nowrap}.sale-product-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}}
@media(max-width:600px){.backup-summary{grid-template-columns:1fr 1fr}.sale-product-grid{grid-template-columns:1fr 1fr}.settings-row{align-items:flex-start}.settings-row>div:first-child{max-width:72%}}

